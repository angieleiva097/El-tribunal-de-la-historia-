
document.addEventListener("DOMContentLoaded", () => {

  const musica =
    document.getElementById("musicaTribunal");

  const expediente =
    document.getElementById("sonidoExpediente");

  const mazo =
    document.getElementById("sonidoMazo");

  const pagina =
    document.getElementById("sonidoPagina");

  const boton =
    document.getElementById("botonMusica");

  const parametros =
    new URLSearchParams(window.location.search);

  const personaje = parametros.get("personaje");

  const esInterior =
    document.body.classList.contains("pagina-expediente");

  /* MÚSICA SEGÚN LA SECCIÓN */

  if (musica) {
    if (esInterior) {
      if (personaje === "biblioteca") {
        musica.src = "musica-biblioteca.mp3";
      } else if (personaje === "secretaria") {
        musica.src = "musica-archivo.mp3";
      } else {
        musica.src = "musica-expedientes.mp3";
      }
    }

    musica.volume = 0.20;
  }

  if (expediente) expediente.volume = 0.75;
  if (mazo) mazo.volume = 0.85;
  if (pagina) pagina.volume = 0.65;

  /* ACTIVAR O SILENCIAR MÚSICA */

  if (boton && musica) {
    boton.addEventListener("click", async () => {

      if (musica.paused) {
        try {
          await musica.play();

          boton.textContent = "🔇 Silenciar música";
          boton.setAttribute("aria-pressed", "true");

        } catch (error) {
          alert(
            "No se pudo reproducir la música. " +
            "Comprueba que el archivo MP3 exista en GitHub."
          );
        }

      } else {
        musica.pause();

        boton.textContent = "🔊 Activar música";
        boton.setAttribute("aria-pressed", "false");
      }

    });
  }

  /* FUNCIÓN GENERAL PARA EFECTOS */

  function reproducir(audio) {
    if (!audio) return;

    try {
      audio.pause();
      audio.currentTime = 0;

      const promesa = audio.play();

      if (promesa && promesa.catch) {
        promesa.catch(() => {});
      }
    } catch (error) {
      console.warn("No se pudo reproducir el efecto.");
    }
  }

  /* EFECTOS EN LAS PÁGINAS INTERIORES */

  document.addEventListener("efectoTribunal", (evento) => {

    const tipo = evento.detail?.tipo;

    if (tipo === "pagina") {
      reproducir(pagina || expediente);
    } else if (tipo === "mazo") {
      reproducir(mazo);
    } else {
      reproducir(expediente);
    }

  });

  /* ICONOS DE LA SALA PRINCIPAL */

  const personajes =
    document.querySelectorAll(".escenario a.icono");

  personajes.forEach((enlace) => {

    enlace.addEventListener("click", (evento) => {

      if (
        evento.defaultPrevented ||
        evento.ctrlKey ||
        evento.metaKey ||
        evento.shiftKey ||
        evento.altKey ||
        evento.button !== 0
      ) {
        return;
      }

      evento.preventDefault();

      const destino = enlace.href;

      if (enlace.classList.contains("juez")) {
        reproducir(mazo);
      } else {
        reproducir(expediente);
      }

      setTimeout(() => {
        window.location.assign(destino);
      }, 550);

    });

  });

});
